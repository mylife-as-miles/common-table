# OpenStreetMap tiles and Photon place search require no API key.
# Optional standalone server settings (defaults shown):
HOST=0.0.0.0
PORT=4173

# Claude is server-only. Mock mode makes no external calls or credit charges.
# Enter the real key ONLY in your secret store or ignored .env.local, never chat.
ANTHROPIC_API_KEY=
ANTHROPIC_MODE=mock
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EXPECTED_ORG_NAME=Startrz
ANTHROPIC_EXPECTED_ORG_ID=
# Live testing is capped in code at $5, with $1 reserved per attempt.
# No top-up, auto-reload, alternate endpoint or browser VITE_* key is supported.
